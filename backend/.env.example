# Copy this file to .env and fill in real values as needed.

# Backend (FastAPI)
JWT_SECRET=change-me-to-a-random-string
CORS_ORIGIN=http://localhost:3000
PORT=5000

# Database (defaults to a local SQLite file under backend/instance/ if unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/document_extractor

# Extraction mode: "rule_based" (default) or "llm" to force LLM-assisted extraction
EXTRACTION_MODE=rule_based
EXTRACTION_LLM_PROVIDER=gemini

# Only needed if you want the LLM-assisted fallback for documents that don't
# match a known template. Leave blank to run fully offline.
GEMINI_API_KEY=
OPENAI_API_KEY=
